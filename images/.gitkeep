<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500">
  <rect width="100%" height="100%" fill="white"/>

  <!-- F symbol -->
  <path d="M190 330 C215 230 225 120 330 70
           L650 70 L625 125 L350 125
           C335 125 325 140 320 160
           L590 160 L560 215 L310 215
           C295 250 285 300 270 350 Z"
        fill="#16a34a"/>

  <!-- Shopping cart -->
  <path d="M390 190 L650 190 L610 300
           L430 300 Z"
        fill="none"
        stroke="#263238"
        stroke-width="22"
        stroke-linejoin="round"/>

  <line x1="420" y1="225" x2="620" y2="225"
        stroke="#263238" stroke-width="14"/>
  <line x1="410" y1="260" x2="605" y2="260"
        stroke="#263238" stroke-width="14"/>

  <circle cx="455" cy="335" r="22" fill="#263238"/>
  <circle cx="590" cy="335" r="22" fill="#263238"/>

  <!-- Brand -->
  <text x="400" y="410"
        text-anchor="middle"
        direction="rtl"
        font-family="Tahoma, Arial"
        font-size="62"
        font-weight="bold"
        fill="#16a34a">فیران کالا</text>

  <text x="400" y="455"
        text-anchor="middle"
        direction="rtl"
        font-family="Tahoma, Arial"
        font-size="20"
        fill="#555">فروشگاه اینترنتی لوازم دیجیتال و تجهیزات مدرن</text>
</svg>
